# Configuration planning template only; no application loads these values yet.
# Copy to .env when implementing. Never commit real credentials.
CLOUDEQ_ENV=development
CLOUDEQ_LOG_LEVEL=INFO
CLOUDEQ_API_HOST=127.0.0.1
CLOUDEQ_API_PORT=8000

# Offline mode is the intended development default; not implemented yet.
CLOUDEQ_ROUTER_MODE=mock
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=
GEMINI_NORMALIZER_MODEL=

# Proposed local service addresses; no services are provisioned by this setup.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=cloudeq.telemetry.raw
KAFKA_CONSUMER_GROUP=cloudeq.observability
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cloudeq
MONGODB_RAW_COLLECTION=raw_events
MONGODB_CANONICAL_COLLECTION=canonical_events

# Intentionally unspecified. Choose independently after reviewing the references.
# Empty means unresolved, not permission to delete data or create TTL indexes.
FOAP_RAW_RETENTION_DAYS=
FOAP_CANONICAL_RETENTION_DAYS=

# Local workspace and dashboard planning values; no runner/dashboard exists yet.
CLOUDEQ_RUNTIME_WORKSPACE_ROOT=./runtime_workspaces
GRAFANA_URL=http://localhost:3000
