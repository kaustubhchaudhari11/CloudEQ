# FORGE SPAN by Cloud EQ — configuration template.
# Plane 1 reads these names from the process environment.
# If .env exists, the API and CLI load it and do not override variables already set.
# Never commit .env or real credentials. Empty secret values are required.
# Offline mode is the default. Live Gemini calls stay disabled.

# Process
CLOUDEQ_ENV=development
CLOUDEQ_LOG_LEVEL=INFO
CLOUDEQ_API_HOST=127.0.0.1
CLOUDEQ_API_PORT=8000

# Routing and normalization stay offline until a later session sets an explicit
# model ID, a local key, router/normalizer mode gemini, and live calls true.
# Do not invent a model ID. The FOAP prototype used Gemini 2.5 Flash; that is
# paper evidence, not this project's configured model.
CLOUDEQ_ROUTER_MODE=offline
CLOUDEQ_NORMALIZER_MODE=offline
CLOUDEQ_GEMINI_LIVE_CALLS=false
CLOUDEQ_GEMINI_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=
GEMINI_NORMALIZER_MODEL=
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Proposal p. 1 ticket intake is in scope and disabled until those adapters exist.
CLOUDEQ_GITHUB_ISSUES_ENABLED=false
CLOUDEQ_JIRA_ENABLED=false
GITHUB_TOKEN=
JIRA_API_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=

# Repair bound is a project default. The proposal requires a Developer–QA loop
# and does not state an iteration count. DevOps handoff waits for an explicit pass.
CLOUDEQ_REPAIR_MAX_ITERATIONS=3
# offline is a labeled simulation. crewai prepares role names and refuses kickoff.
# Empty config uses the packaged plane2_agents/config/agents.yaml.
CLOUDEQ_AGENT_ENGINE=offline
CLOUDEQ_AGENTS_CONFIG=

# Docker is the selected runtime. E2B is the diagram alternative and is not configured.
# Git commit and push stay off. Generated code must not run on the host.
CLOUDEQ_RUNTIME_BACKEND=docker
CLOUDEQ_RUNTIME_WORKSPACE_ROOT=./runtime_workspaces
CLOUDEQ_RUNTIME_NETWORK=none
CLOUDEQ_RUNTIME_TIMEOUT_SECONDS=120
CLOUDEQ_RUNTIME_MEMORY=512m
CLOUDEQ_RUNTIME_CPUS=1
CLOUDEQ_RUNTIME_ALLOW_GIT_COMMIT=false
CLOUDEQ_RUNTIME_ALLOW_GIT_PUSH=false
CLOUDEQ_RUNTIME_ALLOW_HOST_EXECUTION=false

# Kafka and MongoDB addresses are local examples. No services are started here.
# Unit tests must not require them. PostgreSQL is the documented alternative store.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=cloudeq.telemetry.raw
KAFKA_CONSUMER_GROUP=cloudeq.observability
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cloudeq
MONGODB_RAW_COLLECTION=raw_events
MONGODB_CANONICAL_COLLECTION=canonical_events
MONGODB_NORMALIZATION_COLLECTION=normalization_attempts

# Envelope size limit for schema-agnostic payloads. This does not impose a payload schema.
CLOUDEQ_TELEMETRY_MAX_PAYLOAD_BYTES=1048576
CLOUDEQ_CANONICAL_SCHEMA_VERSION=0

# Empty means unresolved. It does not authorize TTL indexes or deletion.
FOAP_RAW_RETENTION_DAYS=
FOAP_CANONICAL_RETENTION_DAYS=

# Grafana will read a future Plane 4 HTTP API through the Infinity datasource.
# Grafana is not given the MongoDB URI. Nothing is provisioned in this session.
GRAFANA_URL=http://localhost:3000
CLOUDEQ_OBSERVABILITY_READ_URL=http://127.0.0.1:8000
